# ============================================
# Futbolify Backend v2 - Environment Variables
# ============================================
# Copia este archivo a .env y reemplaza los valores

# ----------------
# Server Config
# ----------------
NODE_ENV=development
PORT=3001

# ----------------
# Auth Provider
# ----------------
AUTH_PROVIDER=COGNITO

# ----------------
# MongoDB
# ----------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/futbolify

# ----------------
# AWS Cognito
# ----------------
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=your_user_pool_id
AWS_COGNITO_CLIENT_ID=your_client_id
AMZ_ACCESS_KEY_ID=your_access_key_id
AMZ_SECRET_ACCESS_KEY=your_secret_access_key

# ----------------
# AWS SES (Email Service for Quiniela admin emails)
# Nota: Reutiliza AWS_COGNITO_REGION y AMZ_* credentials de arriba
# ----------------
SES_FROM_EMAIL=noreply@futbolify.com

# ----------------
# Google OAuth (opcional - para login con Google)
# ----------------
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ----------------
# OpenAI API (para análisis de apuestas)
# ----------------
# OPENAI_API_KEY=sk-your_openai_api_key

# ----------------
# Anthropic API (Goal Guru - análisis con web_search)
# ----------------
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ----------------
# Goal Guru APIs (Real Data)
# ----------------
# API-Football (fixtures, stats, H2H, injuries)
# Get free key at: https://www.api-football.com/
# API_FOOTBALL_KEY=your_api_football_key

# The Odds API (real betting odds)
# Get free key ($10/month plan) at: https://the-odds-api.com/
# ODDS_API_KEY=your_odds_api_key

# ----------------
# RapidAPI (SofaScore)
# ----------------
USE_RAPIDAPI_SOFA=false
# RAPIDAPI_KEY_SOFA=your_rapidapi_key

# ----------------
# Telegram Bot (Quinielas)
# ----------------
# Create bot at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=futbolify_quinielas_bot
# Optional: Set webhook URL for production (uses polling if not set)
# TELEGRAM_WEBHOOK_URL=https://your-api.com/telegram/webhook

# ----------------
# Telegram Betting Admin
# ----------------
# Your Telegram chat ID for receiving betting alerts
# Get your chat ID by messaging @userinfobot on Telegram
ADMIN_TELEGRAM_ID=your_telegram_chat_id
FOOTBALL_DATA_KEY=your_football_data_key

# ----------------
# Redis (for caching - Betting module)
# ----------------
# Redis URL for caching API-Football responses
# Use Heroku Redis, Upstash, or local Redis
# REDIS_URL=redis://localhost:6379

# ----------------
# Firebase (Realtime Database for Chat)
# ----------------
# Get service account from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
