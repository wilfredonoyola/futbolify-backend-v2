{
  "name": "futbolify-backend",
  "version": "1.0.0",
  "description": "Backend API para Futbolify - plataforma de datos de fútbol y sistema de betting inteligente",
  "author": "Futbolify",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "betting:scan": "node dist/scripts/run-betting-scan.js",
    "betting:seed": "ts-node -r tsconfig-paths/register scripts/seed-betting-leagues.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@apollo/gateway": "^2.8.4",
    "@apollo/server": "^4.9.3",
    "@aws-sdk/client-cognito-identity-provider": "^3.632.0",
    "@aws-sdk/client-ses": "^3.1006.0",
    "@nestjs/apollo": "^12.0.11",
    "@nestjs/bull": "^10.2.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/graphql": "^12.0.11",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/websockets": "^11.1.12",
    "@types/graphql-upload": "^17.0.0",
    "@types/passport-local": "^1.0.38",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "2.28.0",
    "date-fns-tz": "1.3.0",
    "firebase-admin": "^13.7.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^9.15.1",
    "graphql": "16.8.1",
    "graphql-query-complexity": "0.12.0",
    "graphql-subscriptions": "2.0.0",
    "graphql-type-json": "^0.3.2",
    "graphql-upload": "^17.0.0",
    "graphql-ws": "^6.0.7",
    "ioredis": "^5.4.1",
    "moment": "^2.30.1",
    "mongoose": "^8.5.2",
    "openai": "^4.96.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passports": "^0.2.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7",
    "telegraf": "^4.16.3",
    "ts-morph": "^21.0.0",
    "typescript": "^5.3.3",
    "uuid": "^10.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.10",
    "@types/aws-lambda": "^8.10.161",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
