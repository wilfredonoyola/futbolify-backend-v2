{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "src/main",
  "compilerOptions": {
    "assets": [
      {
        "include": "worldcup/data/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "standings/data/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
